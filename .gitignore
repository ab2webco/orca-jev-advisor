node_modules/
.DS_Store
*.log

# Measurement data: calibration knowledge, kept out of the published repo.
.private/
.screenshots/
# Left out deliberately: Orca clones this repo onto every user's machine and
# never installs anything, so a lockfile for a dev-only screenshot tool is
# weight every user carries for a tool no user runs.
package-lock.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
# Local AI runtime state
.atl/

# Orca worktrees live as sibling folders inside the repo root (the same
# convention orca-oss uses); they are checkouts, never content of this one.
/gate-learning-cache-and-deny-threshold/
# Claude Code's own per-agent worktrees and local state.
.claude/
.ignore

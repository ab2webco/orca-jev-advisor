{
  "name": "orca-supervisor",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Multi-project supervisor that routes work to Orca terminals, using Jev (TypeSafe) for judgment and code for the facts.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc -p tsconfig.json && tsc -p adapters/claude/mod-skills/tsconfig.json && tsc -p adapters/claude/mod-skills/tsconfig.test.json",
    "prepare": "node scripts/install-git-hooks.mjs",
    "shots": "node scripts/screenshot-panels.mjs --quick",
    "shots:all": "node scripts/screenshot-panels.mjs",
    "shots:band": "node scripts/screenshot-band.mjs",
    "preflight": "npm run typecheck && npm run test && npm run shots",
    "check": "npm run preflight && npm run test:panels",
    "test:panels": "node --test --test-concurrency=4 scripts/panels.shard-1.spec.mjs scripts/panels.shard-2.spec.mjs scripts/panels.shard-3.spec.mjs scripts/panels.shard-4.spec.mjs",
    "ab-benchmark": "node --experimental-strip-types adapters/cli/ab_benchmark_cli.ts",
    "jev-health": "node --experimental-strip-types adapters/cli/jev_health_cli.ts",
    "measure-module-cost": "node --experimental-strip-types scripts/measure-module-cost.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "playwright": "^1.49.0",
    "typescript": "^5.9.3"
  }
}
